# Admin panel credentials — required for /admin login.
# Locally these are set in .env.local (gitignored). On Vercel, add them in
# Project Settings → Environment Variables.
ADMIN_USERNAME=faizcasm
ADMIN_PASSWORD=your-secure-password-here

# GitHub personal access token (public read scope is enough).
# Used server-side only to avoid GitHub's 60 req/hour anonymous limit.
# Without a token the site still works, but GitHub will rate-limit the server
# and the UI falls back to cached snapshots. GITHUB_TOKEN is accepted as an
# alias if that name is more convenient (e.g. in CI).
GITHUB_SECRET=
GITHUB_TOKEN=

# Contact form (/api/mailer) — Gmail account + app password
# (Google Account → Security → 2-Step Verification → App passwords).
# Never commit real values: they go in .env.local / Vercel env vars.
MAIL_USER=
MAIL_PASS=
# Optional: where contact messages are delivered (defaults to MAIL_USER).
MAIL_TO=

# Database.
# Local development needs nothing — a SQLite file is created at
# data/portfolio.db and seeded from posts/*.md automatically.
#
# On Vercel the filesystem is read-only/ephemeral, so point this at a
# libSQL (Turso) database for persistent blogs. Same code, one env var:
#   DATABASE_URL=libsql://<db-name>-<org>.turso.io
#   TURSO_AUTH_TOKEN=...
# DATABASE_URL=
